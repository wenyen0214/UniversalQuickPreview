<Window x:Class="UniversalQuickPreview.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AppName}"
        Width="760"
        Height="320"
        MinWidth="560"
        MinHeight="260"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <Border Margin="18"
            Background="#FAFAFA"
            BorderBrush="#22000000"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.28" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
                <RowDefinition Height="52" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="22,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="42" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FileNameText"
                           VerticalAlignment="Center"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#171717"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1"
                        Width="32"
                        Height="32"
                        Padding="0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        FontSize="20"
                        Foreground="#666666"
                        Content="×"
                        ToolTip="{DynamicResource ClosePreview}"
                        Click="CloseButton_Click" />
            </Grid>

            <Border Grid.Row="0" VerticalAlignment="Bottom" BorderBrush="#12000000" BorderThickness="0,0,0,1" />

            <Grid Grid.Row="1" Margin="24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#707070"
                           Text="{DynamicResource FullPathLabel}" />
                <TextBlock x:Name="FullPathText"
                           Grid.Row="1"
                           Margin="0,8,0,0"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="14"
                           Foreground="#252525"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="UnavailableText"
                           Grid.Row="2"
                           Margin="0,18,0,0"
                           VerticalAlignment="Top"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="13"
                           Foreground="#B42318"
                           Text="{DynamicResource FileUnavailable}"
                           Visibility="Collapsed" />
            </Grid>

            <Border Grid.Row="2" Background="#F3F3F3" CornerRadius="0,0,12,12">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FileSizeText"
                               VerticalAlignment="Center"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="13"
                               Foreground="#555555" />
                    <TextBlock x:Name="ModifiedText"
                               Grid.Column="2"
                               VerticalAlignment="Center"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="13"
                               Foreground="#555555" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
