<Window x:Class="UniversalQuickPreview.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AppName}"
        Width="860"
        Height="540"
        MinWidth="560"
        MinHeight="360"
        Icon="Assets/AppIcon.png"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <Border Margin="18"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.30" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition x:Name="PathRow" Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="52" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="22,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="42" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FileNameText"
                           VerticalAlignment="Center"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1"
                        Width="32"
                        Height="32"
                        Padding="0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        FontSize="20"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Content="×"
                        ToolTip="{DynamicResource ClosePreview}"
                        Click="CloseButton_Click" />
            </Grid>
            <Border Grid.Row="0" VerticalAlignment="Bottom" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" />

            <Border x:Name="PathPanel"
                    Grid.Row="1"
                    Padding="22,9"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,0,1">
                <TextBlock x:Name="FullPathText"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextTrimming="CharacterEllipsis" />
            </Border>

            <Grid Grid.Row="2" Margin="22,16">
                <Grid x:Name="LoadingPanel">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Width="180" Height="4" IsIndeterminate="True" />
                        <TextBlock Margin="0,14,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="{DynamicResource LoadingPreview}" />
                    </StackPanel>
                </Grid>

                <TextBox x:Name="TextPreview"
                         Padding="14"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         FontFamily="Cascadia Mono, Consolas"
                         FontSize="13"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         Background="{DynamicResource InputBackgroundBrush}"
                         BorderBrush="{DynamicResource DividerBrush}"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"
                         Visibility="Collapsed" />

                <Border x:Name="ImagePanel"
                        Background="{DynamicResource InputBackgroundBrush}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="Collapsed">
                    <Image x:Name="ImagePreview" Margin="12" Stretch="Uniform" />
                </Border>

                <StackPanel x:Name="FallbackPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Text="{DynamicResource PreviewUnavailable}" />
                    <TextBlock x:Name="FallbackTypeText"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>

                <StackPanel x:Name="ErrorPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#DC2626"
                               Text="{DynamicResource PreviewFailed}" />
                    <TextBlock Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="{DynamicResource PreviewFailedDetail}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" CornerRadius="0,0,12,12">
                <Grid Margin="22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="FileSizeText"
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock x:Name="DimensionsText"
                                   Margin="14,0,0,0"
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <Button x:Name="PreviousButton"
                                Margin="0,0,4,0"
                                Padding="10,5"
                                Background="{DynamicResource InputBackgroundBrush}"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="1"
                                Cursor="Hand"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Content="{DynamicResource PreviousFile}"
                                Click="PreviousButton_Click" />
                        <Button x:Name="NextButton"
                                Margin="4,0,0,0"
                                Padding="10,5"
                                Background="{DynamicResource InputBackgroundBrush}"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="1"
                                Cursor="Hand"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Content="{DynamicResource NextFile}"
                                Click="NextButton_Click" />
                    </StackPanel>
                    <TextBlock x:Name="ModifiedText"
                               Grid.Column="2"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
