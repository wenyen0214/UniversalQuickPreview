<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">
    <system:String x:Key="AppName">Universal Quick Preview</system:String>
    <system:String x:Key="ClosePreview">Close preview</system:String>
    <system:String x:Key="FullPathLabel">FULL PATH</system:String>
    <system:String x:Key="FileUnavailable">The selected file is no longer available or cannot be accessed.</system:String>
    <system:String x:Key="FileSizeFormat">{0}</system:String>
    <system:String x:Key="ModifiedFormat">Modified {0:yyyy/MM/dd HH:mm}</system:String>
    <system:String x:Key="LoadingPreview">Loading preview…</system:String>
    <system:String x:Key="PreviewUnavailable">Preview unavailable</system:String>
    <system:String x:Key="PreviewFailed">Preview failed</system:String>
    <system:String x:Key="PreviewFailedDetail">The file may be malformed or currently unavailable.</system:String>
    <system:String x:Key="UnsupportedTypeFormat">{0} file</system:String>
    <system:String x:Key="PreviewTruncated">Showing the first 256K characters</system:String>
    <system:String x:Key="NavigationHint">← Previous   Next →</system:String>
    <system:String x:Key="PreviousFile">← Previous</system:String>
    <system:String x:Key="NextFile">Next →</system:String>
    <system:String x:Key="EnabledMenu">Enabled</system:String>
    <system:String x:Key="SettingsMenu">Settings</system:String>
    <system:String x:Key="LanguageMenu">Language</system:String>
    <system:String x:Key="OpenLogsMenu">Open logs folder</system:String>
    <system:String x:Key="AboutMenu">About</system:String>
    <system:String x:Key="GitHubMenu">GitHub</system:String>
    <system:String x:Key="ExitMenu">Exit</system:String>
    <system:String x:Key="AboutMessage">Select a file in File Explorer and press your configured shortcut to preview it. Use Left or Right to navigate. Press the shortcut, Esc, or click outside to close.</system:String>
    <system:String x:Key="AlreadyRunningMessage">Universal Quick Preview is already running in the notification area.</system:String>
    <system:String x:Key="ShortcutStartFailedMessage">Universal Quick Preview could not start keyboard detection.&#x0a;&#x0a;{0}</system:String>
    <system:String x:Key="SettingsTitle">Settings</system:String>
    <system:String x:Key="SettingsDescription">Customize how quick preview behaves.</system:String>
    <system:String x:Key="EnablePreviewSetting">Enable Quick Preview</system:String>
    <system:String x:Key="LaunchAtStartupSetting">Launch when I sign in to Windows</system:String>
    <system:String x:Key="ShowFullPathSetting">Show the full file path</system:String>
    <system:String x:Key="OutsideClickSetting">Close when clicking outside the preview</system:String>
    <system:String x:Key="ShortcutSetting">Preview shortcut</system:String>
    <system:String x:Key="ThemeSetting">Theme</system:String>
    <system:String x:Key="WindowSizeSetting">Preview window size</system:String>
    <system:String x:Key="SystemTheme">System</system:String>
    <system:String x:Key="LightTheme">Light</system:String>
    <system:String x:Key="DarkTheme">Dark</system:String>
    <system:String x:Key="CompactSize">Compact</system:String>
    <system:String x:Key="MediumSize">Medium</system:String>
    <system:String x:Key="LargeSize">Large</system:String>
    <system:String x:Key="SaveButton">Save</system:String>
    <system:String x:Key="CancelButton">Cancel</system:String>
</ResourceDictionary>
