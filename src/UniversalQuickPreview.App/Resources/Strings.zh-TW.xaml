<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">
    <system:String x:Key="AppName">Universal Quick Preview</system:String>
    <system:String x:Key="ClosePreview">關閉預覽</system:String>
    <system:String x:Key="FullPathLabel">完整路徑</system:String>
    <system:String x:Key="FileUnavailable">選取的檔案已不存在，或目前無法存取。</system:String>
    <system:String x:Key="FileSizeFormat">{0}</system:String>
    <system:String x:Key="ModifiedFormat">修改時間 {0:yyyy/MM/dd HH:mm}</system:String>
    <system:String x:Key="EnabledMenu">啟用快速預覽</system:String>
    <system:String x:Key="LanguageMenu">語言</system:String>
    <system:String x:Key="AboutMenu">關於</system:String>
    <system:String x:Key="ExitMenu">結束</system:String>
    <system:String x:Key="AboutMessage">請在檔案總管選取檔案並按下 Space 進行預覽；按下 Space 或 Esc 即可關閉。</system:String>
    <system:String x:Key="ShortcutStartFailedMessage">Universal Quick Preview 無法啟動鍵盤偵測。&#x0a;&#x0a;{0}</system:String>
</ResourceDictionary>
